{
  "name": "@tkersey/poiesis",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "check": "bun run check:local && bun run check:locks && bun run check:parent && bun run child:deterministic && bun run child:retry && bun run child:replay && bun run child:measure",
    "check:local": "zig build check --summary all && bun test scaffold/test/*.mjs",
    "check:locks": "bun tools/check-lock.mjs",
    "check:parent": "bun tools/verify-parent.mjs",
    "parent:acquire": "bun tools/acquire-parent.mjs",
    "parent:verify": "bun tools/verify-parent.mjs",
    "birth:live": "bun tools/run-birth.mjs",
    "birth:verify": "bun tools/verify-birth.mjs",
    "birth:publish": "bun tools/publish-birth.mjs",
    "child:freeze": "bun tools/freeze-child.mjs",
    "child:deterministic": "bun tools/run-child.mjs --mode deterministic",
    "child:retry": "bun tools/run-child.mjs --mode retry",
    "child:replay": "bun tools/run-child.mjs --mode replay",
    "child:measure": "bun tools/run-child.mjs --mode measure",
    "child:live": "bun tools/run-child.mjs --mode live",
    "child:verify": "bun tools/verify-child.mjs",
    "child:publish": "bun tools/publish-child.mjs",
    "lineage:verify": "bun tools/verify-lineage.mjs",
    "release:build": "bun tools/build-release.mjs"
  }
}
